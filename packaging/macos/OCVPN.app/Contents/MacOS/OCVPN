#!/bin/sh
# Лаунчер OCVPN.app — tkinter-GUI из установленного пакета.
# Проверяет python3+tkinter и показывает понятное сообщение, если их нет.

GUI=/usr/local/lib/ocvpn/ocvpn-gui.py

if [ ! -x /usr/bin/python3 ]; then
    osascript -e 'display dialog "Не найден /usr/bin/python3 — установите Xcode Command Line Tools:  xcode-select --install" buttons {"OK"} default button 1 with icon caution' 2>/dev/null
    exit 1
fi

if ! /usr/bin/python3 -c "import tkinter" 2>/dev/null; then
    osascript -e 'display dialog "В /usr/bin/python3 нет модуля tkinter — GUI не запустится.  Установите: brew install python-tk (или python.org Python) и перезапустите." buttons {"OK"} default button 1 with icon caution' 2>/dev/null
    exit 1
fi

exec /usr/bin/python3 "$GUI"